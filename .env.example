# Edu.Plan — Variáveis de Ambiente (copie para .env e preencha)

# 1. Google Gemini API (GRATUITA — 1.500 req/dia, sem cartão)
# Obtenha em: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=sua_chave_gemini_aqui

# 2. DeepSeek API (opcional, paga)
# Obtenha em: https://platform.deepseek.com/
VITE_DEEPSEEK_API_KEY=sua_chave_deepseek_aqui

# 3. Firebase (autenticação)
VITE_FIREBASE_API_KEY=sua_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=eduplan-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=eduplan-app
VITE_FIREBASE_STORAGE_BUCKET=eduplan-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
